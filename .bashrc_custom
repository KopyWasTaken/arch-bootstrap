# custom functions
# Function that automatically pushes all changes with a commit message to github
git-cmp() {
    if [ -z "$1" ]; then
        echo "Usage: git-cmp \"commit message\""
        return 1
    fi
    git add -A 
    git commit -m "$1"
    git push
}
